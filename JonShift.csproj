<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LaneShifter</AssemblyName>
    <RootNamespace>LaneShifter</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <!-- Harmony via NuGet (compile-time only; game ships its own 0Harmony.dll at runtime) -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Cities Skylines managed DLLs (provided by GitHub Actions via CS_MANAGED env var) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CS_MANAGED)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CS_MANAGED)/ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(CS_MANAGED)/ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CS_MANAGED)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(CS_MANAGED)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- UnifiedUILib: optional. Drop UnifiedUILib.dll into lib/ to compile with UUI support. -->
  <!-- UUI detection at runtime is done via reflection, so the build works without it.     -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/lib/UnifiedUILib.dll')">
    <Reference Include="UnifiedUILib">
      <HintPath>$(MSBuildProjectDirectory)/lib/UnifiedUILib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Embedded icon (add icon.png to repo root to replace the fallback green square) -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/icon.png')">
    <EmbeddedResource Include="icon.png" />
  </ItemGroup>

</Project>
