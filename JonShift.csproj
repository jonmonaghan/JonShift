<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LaneShifter</AssemblyName>
    <RootNamespace>LaneShifter</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <!-- Cities Skylines managed DLLs (provided by GitHub Actions) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(CS_MANAGED)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CS_MANAGED)/ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(CS_MANAGED)/ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CS_MANAGED)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(CS_MANAGED)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony (bundled in repo under lib/) -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildProjectDirectory)/lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- UnifiedUILib: optional at runtime; included in lib/ only if present -->
  <!-- We reference it only when the file exists so the CI does NOT fail    -->
  <!-- when the DLL is absent — UUI detection is done via reflection.       -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/lib/UnifiedUILib.dll')">
    <Reference Include="UnifiedUILib">
      <HintPath>$(MSBuildProjectDirectory)/lib/UnifiedUILib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
